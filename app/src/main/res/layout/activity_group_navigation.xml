<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="#EEFFFFFF"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_navigation_title"
            android:textAppearance="@android:style/TextAppearance.Material.Title"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/destinationSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/destinationSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/group_destination_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textPostalAddress"
                android:maxLines="1" />

            <Button
                android:id="@+id/destinationSearchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_destination_search" />
        </LinearLayout>

        <TextView
            android:id="@+id/routeStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/group_route_waiting" />

        <TextView
            android:id="@+id/navigationInstructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#102A43"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/navigationProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#334E68"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offRouteStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#C62828"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/memberLocationStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/group_location_waiting"
            android:textColor="#455A64"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/routeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="#EEFFFFFF"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="10dp">

        <Button
            android:id="@+id/shareRouteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/group_route_share"
            android:visibility="gone" />

        <Button
            android:id="@+id/clearRouteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/group_route_clear"
            android:visibility="gone" />

        <Button
            android:id="@+id/followNavigationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/group_navigation_follow"
            android:visibility="gone" />

        <Button
            android:id="@+id/recalculateRouteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/group_route_recalculate"
            android:visibility="gone" />

        <Button
            android:id="@+id/leaveNavigationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/leave_navigation" />

        <Button
            android:id="@+id/backToCommsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_to_comms" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/routing_attribution"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
