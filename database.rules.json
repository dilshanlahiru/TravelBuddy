{
  "rules": {
    ".read": false,
    ".write": false,
    "signaling": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "room_status": {
      "$roomId": {
        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    }
  }
}
