{
  "name": "travel-buddy-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint .",
    "test:rules": "firebase --config ../firebase.json --project demo-travel-buddy emulators:exec --only firestore,database \"npm --prefix rules-tests test\"",
    "test:functions": "firebase --config ../firebase.json --project demo-travel-buddy emulators:exec --only auth,functions,firestore,database \"node --test test/functions.test.js\"",
    "test:phase1": "npm run test:rules && npm run test:functions",
    "deploy": "firebase deploy --only functions,firestore:rules,database"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "firebase-tools": "^15.33.0"
  }
}
